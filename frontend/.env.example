# Local Next.js development (separate ports).
# Copy to frontend/.env.local (do not commit secrets):
#   NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1
#   NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1
#   NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000
#   NEXT_PUBLIC_API_ORIGIN=http://127.0.0.1:8000
#   NEXT_PUBLIC_USE_SAME_ORIGIN=false
#   NEXT_PUBLIC_FORBID_LOOPBACK=false
#
# Kaggle (scripts/run_kaggle.py overwrites frontend/.env.local):
#   Default GATEWAY: open PORT 8000. API is same-origin /api/v1 (never loopback).
#   Split (--no-base-path): UI PORT 3000, API /k/<session>/proxy/proxy/8000/api/v1
#   NEXT_PUBLIC_FORBID_LOOPBACK=true
# After a Kaggle session, restore local URLs with:
#   python scripts/run_local.py
#