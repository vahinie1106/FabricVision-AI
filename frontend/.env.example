# Local Next.js development (separate ports).
# Copy to .env.local for local Next.dev (do not commit secrets):
#   NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1
#   NEXT_PUBLIC_API_ORIGIN=http://127.0.0.1:8000
#
# Kaggle (scripts/run_kaggle.py overwrites .env.local):
#   NEXT_PUBLIC_API_URL=/proxy/8000/api/v1   (or /proxy/proxy/8000/api/v1)
#   NEXT_PUBLIC_API_ORIGIN=/proxy/8000
#   NEXT_PUBLIC_FORBID_LOOPBACK=true
#   NEXT_PUBLIC_ASSET_PREFIX=/k/<session>/proxy/proxy/3000
# Browser UI is PORT 3000. Browser API is PORT 8000 — never notebook loopback.
#