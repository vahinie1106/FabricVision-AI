# Local Next.js development (separate ports). Frontend defaults to
# http://127.0.0.1:8000/api/v1 when NEXT_PUBLIC_* are unset.
#
# Kaggle / single-port gateway:
#   scripts/run_kaggle.py sets NEXT_PUBLIC_BASE_PATH dynamically from the live
#   Jupyter server base_url (not a hard-coded /proxy/8000).
#
# Optional local overrides (copy to .env.local — do not commit secrets):
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1
# NEXT_PUBLIC_API_ORIGIN=http://127.0.0.1:8000
